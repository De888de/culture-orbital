<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Орбиталь — Культура</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
:root{--bg:#0b0f19;--gold:#f5c451;--green:#31e08a;--txt:#eef2ff;--muted:#8b97b5}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--txt);font-family:system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;min-height:100vh;padding:16px}
h1{color:var(--gold);margin:10px 0}
.bal{font-size:28px;font-weight:800;color:#fff;margin:8px 0}
.ps{color:var(--green);font-weight:700}
button{background:linear-gradient(145deg,#ffe7a3,var(--gold));border:0;border-radius:14px;padding:12px 20px;font-weight:800;cursor:pointer;margin:6px}
.card{background:#141b2d;border:1px solid rgba(255,255,255,.07);border-radius:16px;padding:14px;margin:10px 0;width:100%;max-width:420px}
.quote{font-style:italic;color:var(--muted);font-size:13px;margin-top:8px}
</style>
</head>
<body>
<div id="app">
  <h1>🌌 Орбиталь</h1>
  <div class="bal">Энергия: <span id="energy">0</span></div>
  <div class="ps" id="perSec">+0 / сек</div>
  <button id="tap">⚡ Собрать энергию</button>

  <div class="card">
    <b>Секции орбитали</b>
    <div id="sections"></div>
  </div>

  <div class="card">
    <b>Достижения</b>
    <div id="ach"></div>
  </div>
</div>

<script>
const tg = window.Telegram?.WebApp;
if (tg) { tg.ready(); tg.expand(); }

const SECTIONS = [
  { id:'hub', name:'Центральный хаб', base:1, cost:15, mult:1.15 },
  { id:'mind', name:'Майнд', base:8, cost:120, mult:1.18 },
  { id:'ship', name:'Корабль Культуры', base:40, cost:900, mult:1.2 },
  { id:'contact', name:'Контакт', base:180, cost:6000, mult:1.22 },
  { id:'sc', name:'Special Circumstances', base:900, cost:45000, mult:1.25 }
];

const QUOTES = [
  { id:'q1', req:100, text:'«Деньги — признак бедности.» — Иэн М. Бэнкс' },
  { id:'q2', req:1000, text:'«Культура не завоёвывает. Она убеждает.»' },
  { id:'q3', req:10000, text:'«Орбиталь — это не место. Это состояние.»' },
  { id:'q4', req:100000, text:'«Майнд думает быстрее, чем ты успеваешь моргнуть.»' },
  { id:'q5', req:1000000, text:'«Special Circumstances делают то, чего не делают другие.»' }
];

let S = { energy:0, sections:{}, ach:{}, total:0 };
try { S = JSON.parse(localStorage.getItem('orbital') || 'null') || S; } catch(e){}

function save(){ localStorage.setItem('orbital', JSON.stringify(S)); }
function fmt(n){ return n>=1e6?(n/1e6).toFixed(2)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':Math.floor(n); }

function income(){
  return SECTIONS.reduce((s,sec)=> s + (S.sections[sec.id]||0)*sec.base, 0);
}

function render(){
  document.getElementById('energy').textContent = fmt(S.energy);
  document.getElementById('perSec').textContent = '+' + fmt(income()) + ' / сек';

  const box = document.getElementById('sections');
  box.innerHTML = '';
  SECTIONS.forEach(sec=>{
    const cnt = S.sections[sec.id]||0;
    const cost = Math.floor(sec.cost * Math.pow(sec.mult, cnt));
    const can = S.energy >= cost;
    const el = document.createElement('div');
    el.style.margin = '8px 0';
    el.innerHTML = `<div>${sec.name} <b>x${cnt}</b> (+${sec.base}/сек)</div>
      <button ${can?'':'disabled'} data-id="${sec.id}">Купить (${fmt(cost)})</button>`;
    box.appendChild(el);
  });

  const ach = document.getElementById('ach');
  ach.innerHTML = '';
  QUOTES.forEach(q=>{
    const done = S.ach[q.id];
    const el = document.createElement('div');
    el.className = 'quote';
    el.style.opacity = done ? 1 : 0.4;
    el.textContent = done ? q.text : `??? (нужно ${fmt(q.req)} энергии)`;
    ach.appendChild(el);
  });
}

document.getElementById('tap').onclick = ()=>{
  S.energy += 1 + income()*0.1;
  S.total += 1;
  checkAch();
  render(); save();
};

document.getElementById('sections').onclick = e=>{
  const id = e.target.dataset.id;
  if(!id) return;
  const sec = SECTIONS.find(s=>s.id===id);
  const cnt = S.sections[id]||0;
  const cost = Math.floor(sec.cost * Math.pow(sec.mult, cnt));
  if(S.energy >= cost){
    S.energy -= cost;
    S.sections[id] = cnt+1;
    checkAch();
    render(); save();
  }
};

function checkAch(){
  QUOTES.forEach(q=>{
    if(!S.ach[q.id] && S.total >= q.req){
      S.ach[q.id] = true;
      alert(q.text);
    }
  });
}

setInterval(()=>{
  const inc = income();
  if(inc>0){ S.energy += inc; S.total += inc; checkAch(); render(); save(); }
}, 1000);

render();
</script>
</body>
</html>
